# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# AI Analysis layer — server-side only. Never use NEXT_PUBLIC_ here.
PERPLEXITY_API_KEY=

# Cron job security
CRON_SECRET=

# CSRF protection (server-side only. Never use NEXT_PUBLIC_ here.)
CSRF_SECRET=

# BCAutoLoan Configuration (REQUIRED for CRM integration)
BCAUTOLOAN_DEALERSHIP_ID=
BCAUTOLOAN_CREATED_BY_USER_ID=

# Optional: Production domain for canonical URLs
NEXT_PUBLIC_BCAUTOLOAN_DOMAIN=

# Optional: Financing handoff (disabled by default)
BCAUTOLOAN_FINANCING_ENABLED=false
BCAUTOLOAN_FINANCING_API_URL=
BCAUTOLOAN_FINANCING_API_KEY=

# BCAutoLoan email notifications
RESEND_API_KEY=
BCAUTOLOAN_FROM_EMAIL=notifications@bcautoloan.ca
BCAUTOLOAN_NOTIFICATION_EMAIL=BcAutoLoanca@gmail.com
