{
  "manifest_version": 3,
  "name": "Shiftly Auto - Vehicle Intelligence",
  "version": "0.1.0",
  "description": "Detects VINs on approved dealership inventory sites and runs a vehicle history report in Shiftly Auto.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}